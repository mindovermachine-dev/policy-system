# PS Service environment variables — copy to `.env` (git-ignored) and fill in.
# See CONTRIBUTING.md's "Configure the LLM Interface" section for worked
# examples. No real secrets belong in this file — it is committed to git.

# --- ps_service.config.ServiceConfig (PS_SERVICE_*/PS_LOGGING_DIR) ---

# Host uvicorn binds to. Default if unset: 127.0.0.1
PS_SERVICE_HOST=127.0.0.1

# Port uvicorn binds to. Default if unset: 8000
PS_SERVICE_PORT=8000

# Seconds uvicorn waits for in-flight requests to finish on SIGTERM before
# forcing shutdown. Default if unset: 10
PS_SERVICE_GRACEFUL_SHUTDOWN_SECONDS=10

# Directory the Logging component writes its log file into. Default if
# unset: resolved by ps_service.logging.facade.resolve_default_log_path().
#PS_LOGGING_DIR=

# --- ps_service.llm_interface (RouteCompletion/RouteEmbedding routing) ---
#
# Both are LiteLLM-recognized "<provider>/<model-or-deployment-name>"
# strings, passed straight through to litellm.completion()/litellm.embedding().
# No default — RouteCompletion/RouteEmbedding require one to be set. Provider
# credentials (below) are separate env vars that LiteLLM resolves itself —
# never part of ServiceConfig.

# -- Option 1: Azure (active by default here) --
PS_LLMINTERFACE_MODEL=azure/gpt-5.4-mini
PS_LLMINTERFACE_EMBED_MODEL=azure/text-embedding-3-large
AZURE_API_KEY=
AZURE_API_BASE=

# -- Option 2: Ollama (local, no cloud credentials/cost) --
#PS_LLMINTERFACE_MODEL=ollama/phi3:mini
#PS_LLMINTERFACE_EMBED_MODEL=ollama/nomic-embed-text
# Only needed if Ollama isn't on its default localhost:11434 — LiteLLM
# resolves this itself; empirically confirmed unset works against a
# default-config local Ollama instance.
#OLLAMA_API_BASE=

# --- ps_service.ingestion (FalkorDB connection) ---
# Host FalkorDB is reachable at. Default if unset: 127.0.0.1
PS_FALKORDB_HOST=127.0.0.1
# Port FalkorDB is reachable at. Default if unset: 6379
PS_FALKORDB_PORT=6379

# --- ps_service.company_merge (MergeBaselineGraph dedupe-match cutoff) ---
#
# Float greater than 0.0 and at most 1.0. No default — MergeBaselineGraph
# requires it to be set. See CONTRIBUTING.md's "Configure Company Merge"
# section.
PS_COMPANYMERGE_SIMILARITY_THRESHOLD=0.59

# --- ps_service.config.ServiceConfig (request handling, query limits, runs) ---

# Authentication bypass: when "true", every request runs as a fixed local-test
# principal. Accepts "true" or "false". Default if unset: false
#PS_SERVICE_LOCAL_TEST_BYPASS=false

# Largest accepted request body in bytes, checked against the Content-Length
# header before any body is read. Positive integer. Default if unset: 104857600
#PS_SERVICE_MAX_REQUEST_BODY_BYTES=104857600

# Server-side time limit for one Cypher query, in milliseconds. Positive
# integer. Default if unset: 5000
#PS_QUERY_TIMEOUT_MS=5000

# Maximum rows one Cypher query returns. Positive integer. Default if unset:
# 1000
#PS_QUERY_ROW_CAP=1000

# Seconds between two passes of the graph write gateway's drift check. 0 turns
# the periodic check off. Default if unset: 3600
#PS_GRAPHGATEWAY_DRIFT_CHECK_INTERVAL_SECONDS=3600

# Most ingestion runs executing concurrently in one process. Positive
# integer. Default if unset: 1
#PS_INGESTIONRUNS_MAX_IN_FLIGHT=1

# Name of the FalkorDB graph the single-tenant components read and write.
# Read directly by several components rather than through ServiceConfig.
# Default if unset: policy_system
#PS_FALKORDB_GRAPH=policy_system

# --- ps_service.config.ServiceConfig (authentication) ---
#
# Issuer and audience are required unless the local-test bypass is active.

# Expected token issuer.
#PS_AUTH_ISSUER=
# Expected token audience.
#PS_AUTH_AUDIENCE=
# OAuth client id advertised to command-line clients. Optional.
#PS_AUTH_CLI_CLIENT_ID=
# Informational scope names advertised to clients, split on commas and
# whitespace. Never enforced as authorization. Optional.
#PS_AUTH_SCOPES=

# Subject (sub) and issuer (iss) of the operator-designated first system
# owner. Required unless the local-test bypass is active.
#PS_AUTHZ_BOOTSTRAP_OWNER_SUBJECT=
#PS_AUTHZ_BOOTSTRAP_OWNER_ISSUER=

# --- ps_service.config.ServiceConfig (identity provider invitations) ---

# PS Service's own credential for the identity provider's invitation API.
# Required at startup together with the base URL.
#PS_AUTHENTIK_API_TOKEN=
# Base URL of the identity provider's API.
#PS_AUTHENTIK_BASE_URL=
# Base of the invitee-facing enrollment link. Optional; the API base URL is
# used when unset.
#PS_AUTHENTIK_PUBLIC_URL=

# --- ps_service.config.ServiceConfig (curated content source) ---

# Base URL the curated-content catalog is fetched from. Default if unset: this
# project's public curated-content tree on raw.githubusercontent.com
#PS_CURATEDSOURCE_URL=

# Whether a plain http source URL is accepted. "true" or "false". Default if
# unset: false (TLS required)
#PS_CURATEDSOURCE_ALLOW_INSECURE_HTTP=false

# --- ps_service.config.ServiceConfig (Postgres instances) ---
#
# Passkey Signing's own Postgres instance. When the host is unset, Passkey
# Signing treats its store as not applicable.
#PS_PASSKEYSIGNING_POSTGRES_HOST=
# Default if unset: 5432
#PS_PASSKEYSIGNING_POSTGRES_PORT=5432
#PS_PASSKEYSIGNING_POSTGRES_DATABASE=
#PS_PASSKEYSIGNING_POSTGRES_USER=
#PS_PASSKEYSIGNING_POSTGRES_PASSWORD=

# The PS state Postgres instance. When the host is unset, every state-store
# caller fails closed and every role-gated action is denied.
#PS_STATE_POSTGRES_HOST=
# Default if unset: 5432
#PS_STATE_POSTGRES_PORT=5432
#PS_STATE_POSTGRES_DATABASE=
#PS_STATE_POSTGRES_USER=
#PS_STATE_POSTGRES_PASSWORD=
