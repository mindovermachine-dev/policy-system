INGRESS_PORT = 30443
HTTP_OK = 200
HTTP_FOUND = 302
HTTP_CREATED = 201
HTTP_NO_CONTENT = 204
HTTP_BAD_REQUEST = 400
HTTP_UNAUTHORIZED = 401
