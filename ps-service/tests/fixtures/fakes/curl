def _fixture(name: str) -> Any:  # noqa: ANN401 - recorded JSON documents are heterogeneous
    """A deep copy of the recorded Authentik response `name` (see module docstring)."""
    root = Path(
        os.environ.get("PS_TEST_CURL_FIXTURES", Path(__file__).resolve().parent / "authentik")
    )
    return copy.deepcopy(json.loads((root / f"{name}.json").read_text(encoding="utf-8")))


def _envelope(results: list[Any]) -> dict[str, Any]:
    """The recorded paginated list envelope (users and devices share it) holding `results`."""
    body: dict[str, Any] = _fixture("users_list")
    body["results"] = results
    body["pagination"].update(
        count=len(results), total_pages=1, start_index=1 if results else 0, end_index=len(results)
    )
    return body


def _admins_group() -> dict[str, Any]:
    group: dict[str, Any] = _fixture("groups_list")["results"][0]
    return group


def _load_state(path: Path) -> dict[str, Any]:
    if path.exists():
        loaded: dict[str, Any] = json.loads(path.read_text(encoding="utf-8"))
        return loaded
    return {}


def _save_state(path: Path, state: dict[str, Any]) -> None:
    path.write_text(json.dumps(state), encoding="utf-8")


def _parse_args(argv: list[str]) -> dict[str, Any]:
    parsed: dict[str, Any] = {
        "method": None,
        "data": None,
        "write_out": None,
        "url": None,
        "config_stdin": False,
    }
    value_flags = {
        "-X": "method",
        "--request": "method",
        "-d": "data",
        "--data": "data",
        "--data-raw": "data",
        "-w": "write_out",
        "--write-out": "write_out",
    }
    ignored_with_value = {
        "--cacert",
        "--resolve",
        "-H",
        "--header",
        "-o",
        "--output",
        "--max-time",
        "-m",
        "--connect-timeout",
        "--retry",
    }
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in value_flags:
            parsed[value_flags[arg]] = argv[i + 1]
            i += 2
        elif arg in {"--config", "-K"}:
            parsed["config_stdin"] = argv[i + 1] == "-"
            i += 2
        elif arg in ignored_with_value:
            i += 2
        elif arg.startswith("-"):
            i += 1
        else:
            parsed["url"] = arg
            i += 1
    return parsed


def _bearer_token(*, config_stdin: bool) -> str | None:
    if not config_stdin:
        return None
    match = re.search(r"Bearer ([^\"\s]+)", sys.stdin.read())
    return match.group(1) if match else None


def _user_document(body: dict[str, Any], pk: int) -> dict[str, Any]:
    """A created-user response: the recorded shape with this request's values filled in."""
    admins = _admins_group()
    user: dict[str, Any] = _fixture("user_created")
    groups = body.get("groups", [])
    user.update(
        pk=pk,
        username=body["username"],
        name=body["name"],
        email=body.get("email", ""),
        type=body.get("type", "internal"),
        groups=groups,
        groups_obj=[{**admins, "users": [], "users_obj": []}] if admins["pk"] in groups else [],
        is_superuser=admins["pk"] in groups,
        uuid=str(uuid.uuid4()),
    )
    return user


# Device types: meta_model_name -> (path under /api/v3, model name in a 404 detail).
WEBAUTHN_DEVICE = "authentik_stages_authenticator_webauthn.webauthndevice"
ENDPOINT_DEVICE = "authentik_stages_authenticator_endpoint_gdtc.endpointdevice"
ISE_DEVICE = "authentik_endpoints_connectors_agent.appleindependentsecureenclave"
DEVICE_TYPES: dict[str, tuple[str, str]] = {
    WEBAUTHN_DEVICE: ("/authenticators/admin/webauthn/", "WebAuthnDevice"),
    "authentik_stages_authenticator_totp.totpdevice": ("/authenticators/admin/totp/", "TOTPDevice"),
    "authentik_stages_authenticator_static.staticdevice": (
        "/authenticators/admin/static/",
        "StaticDevice",
    ),
    "authentik_stages_authenticator_duo.duodevice": ("/authenticators/admin/duo/", "DuoDevice"),
    "authentik_stages_authenticator_sms.smsdevice": ("/authenticators/admin/sms/", "SMSDevice"),
    "authentik_stages_authenticator_email.emaildevice": (
        "/authenticators/admin/email/",
        "EmailDevice",
    ),
    ENDPOINT_DEVICE: ("/authenticators/admin/endpoint/", "EndpointDevice"),
    ISE_DEVICE: ("/endpoints/agents/psso/ise/", "AppleIndependentSecureEnclave"),
}
DEVICE_PATH = re.compile(
    r"/api/v3(/authenticators/admin/(?:webauthn|totp|static|duo|sms|email|endpoint)/"
    r"|/endpoints/agents/psso/ise/)(?:([^/]+)/)?$"
)


def _device_type(device: dict[str, Any]) -> str:
    kind: str = device.get("type", WEBAUTHN_DEVICE)
    return kind


def _type_for_path(type_path: str) -> str:
    return next(kind for kind, (path, _) in DEVICE_TYPES.items() if path == type_path)


def _device_retrieve(device: dict[str, Any], user: dict[str, Any]) -> dict[str, Any]:
    """A per-type device retrieve in the recorded shape of its type."""
    kind = _device_type(device)
    name = device.get("name", "")
    if kind == ENDPOINT_DEVICE:
        endpoint: dict[str, Any] = _fixture("device_endpoint_admin_retrieve")
        endpoint.update(pk=str(device["pk"]), name=name)
        return endpoint
    if kind == ISE_DEVICE:
        enclave: dict[str, Any] = _fixture("device_ise_admin_retrieve")
        enclave.update(uuid=str(device["pk"]), user=user["pk"])
        return enclave
    document: dict[str, Any] = _fixture("device_webauthn_admin_retrieve")
    pk = device["pk"]
    document.update(pk=int(pk) if str(pk).isdigit() else pk, name=name)
    document["user"].update(
        pk=user["pk"], username=user["username"], name=user["username"], email=user["username"]
    )
    return document


def _user_or_stub(users: dict[str, dict[str, Any]], pk: str) -> dict[str, Any]:
    return users.get(pk, {"pk": int(pk), "username": pk})


def _find_device(
    devices: dict[str, list[dict[str, Any]]], kind: str, pk: str
) -> tuple[str, dict[str, Any]] | None:
    for user_pk, user_devices in devices.items():
        for device in user_devices:
            if _device_type(device) == kind and str(device["pk"]) == pk:
                return user_pk, device
    return None


def _device_route(
    method: str,
    match: re.Match[str],
    users: dict[str, dict[str, Any]],
    devices: dict[str, list[dict[str, Any]]],
) -> tuple[int, Any]:
    """Per-type device list, retrieve and delete (`<type path>[<pk>/]`)."""
    kind = _type_for_path(match.group(1))
    pk = match.group(2)
    if pk is None and method == "GET":
        # Real Authentik ignores `user`/`user__username` here and lists every user's devices.
        found = [
            _device_retrieve(d, _user_or_stub(users, u))
            for u, user_devices in devices.items()
            for d in user_devices
            if _device_type(d) == kind
        ]
        return HTTP_OK, _envelope(found)
    hit = _find_device(devices, kind, unquote(pk or ""))
    if hit is None:
        missing: dict[str, str] = _fixture("device_delete_again_404")
        missing["detail"] = missing["detail"].replace("WebAuthnDevice", DEVICE_TYPES[kind][1])
        return HTTP_NOT_FOUND, missing
    user_pk, device = hit
    if method == "GET":
        return HTTP_OK, _device_retrieve(device, _user_or_stub(users, user_pk))
    if method == "DELETE":
        devices[user_pk].remove(device)
        return HTTP_NO_CONTENT, None
    return HTTP_NOT_FOUND, {"detail": f"fake curl: no route for {method} {match.group(0)}"}


def _device_documents(
    users: dict[str, dict[str, Any]], devices: dict[str, list[dict[str, Any]]]
) -> list[dict[str, Any]]:
    """Every WebAuthn device in the recorded admin-list shape (device plus embedded user)."""
    template: dict[str, Any] = _fixture("webauthn_admin_list_unfiltered")["results"][0]
    documents: list[dict[str, Any]] = []
    for user_pk, user_devices in devices.items():
        user = users.get(user_pk, {"pk": int(user_pk), "username": user_pk})
        for device in user_devices:
            if _device_type(device) != WEBAUTHN_DEVICE:
                continue
            document = copy.deepcopy(template)
            document.update(pk=device["pk"], name=device.get("name", template["name"]))
            document["user"].update(pk=user["pk"], username=user["username"])
            documents.append(document)
    return documents


def _devices_all(
    query: dict[str, list[str]],
    users: dict[str, dict[str, Any]],
    devices: dict[str, list[dict[str, Any]]],
    ignore_user_filters: list[str],
) -> tuple[int, Any]:
    """`GET /authenticators/admin/all/?user=<pk>`: the real per-user device filter."""
    pk = query.get("user", [""])[0]
    if pk not in users:
        return HTTP_BAD_REQUEST, {"user": [f'Invalid pk "{pk}" - object does not exist.']}
    rows = {row["meta_model_name"]: row for row in _fixture("devices_all_owner_every_type")}
    owners = list(devices) if "devices" in ignore_user_filters else [pk]
    found: list[dict[str, Any]] = []
    for owner in owners:
        for device in devices.get(owner, []):
            kind = _device_type(device)
            template = rows.get(kind, {**rows[WEBAUTHN_DEVICE], "meta_model_name": kind})
            found.append({**template, "pk": str(device["pk"]), "name": device.get("name", "")})
    return HTTP_OK, found


PAGE_SIZE_DEFAULT = 20
PAGE_SIZE_MAX = 100


def _paginate(
    rows: list[Any], query: dict[str, list[str]], state: dict[str, Any]
) -> tuple[int, Any]:
    """One page of `rows` in the recorded paginated envelope, as Authentik pages a list."""
    size = min(int(query.get("page_size", [PAGE_SIZE_DEFAULT])[0]), PAGE_SIZE_MAX)
    page = int(query.get("page", ["1"])[0])
    total_pages = max(1, math.ceil(len(rows) / size))
    if page > total_pages:
        return HTTP_NOT_FOUND, {"detail": "Invalid page."}
    start = (page - 1) * size
    found = rows[start : start + size]
    body = _envelope(found)
    body["pagination"].update(
        next=state.get("stuck_next_page", page + 1 if page < total_pages else 0),
        previous=page - 1,
        current=page,
        total_pages=total_pages,
        start_index=start + 1 if found else 0,
        end_index=start + len(found),
    )
    return HTTP_OK, body


def _user_pk_by_username(users: dict[str, dict[str, Any]], username: str) -> int | None:
    return next((int(pk) for pk, u in users.items() if u["username"] == username), None)


def _owned_by(
    rows: dict[str, dict[str, Any]], owner: int | None, *, ignored: bool
) -> list[tuple[str, dict[str, Any]]]:
    return [(key, row) for key, row in rows.items() if ignored or row["user"] == owner]


def _username_filtered(
    query: dict[str, list[str]], users: dict[str, dict[str, Any]], *, ignored: bool
) -> tuple[int | None, bool]:
    """The owner a `user__username` query names; `user` is ignored. No filter lists everyone."""
    if "user__username" not in query:
        return None, True
    return _user_pk_by_username(users, unquote(query["user__username"][0])), ignored


def _embedded_user(users: dict[str, dict[str, Any]], pk: int) -> dict[str, Any]:
    user = _user_or_stub(users, str(pk))
    return {
        "pk": pk,
        "username": user["username"],
        "name": user["username"],
        "email": user["username"],
    }


def _sessions_route(
    method: str, path: str, query: dict[str, list[str]], state: dict[str, Any]
) -> tuple[int, Any]:
    """`/core/authenticated_sessions/`: list (by `user__username`), delete, bulk delete."""
    users: dict[str, dict[str, Any]] = state.setdefault("users", {})
    sessions: dict[str, dict[str, Any]] = state.setdefault("sessions", {})
    key = path.rsplit("/core/authenticated_sessions/", maxsplit=1)[-1].strip("/")
    if key == "bulk_delete" and method == "DELETE":
        if "user_pks" not in query:
            return HTTP_BAD_REQUEST, {"user_pks": ["This field is required."]}
        pks = {int(pk) for pk in query["user_pks"]}
        gone = [uuid_ for uuid_, row in sessions.items() if row["user"] in pks]
        for uuid_ in gone:
            del sessions[uuid_]
        return HTTP_OK, {"deleted": len(gone)}
    if not key and method == "GET":
        owner, ignored = _username_filtered(
            query, users, ignored="sessions" in state.get("ignore_user_filters", [])
        )
        template: dict[str, Any] = _fixture("sessions_list_owner")["results"][0]
        rows = [
            {**copy.deepcopy(template), "uuid": uuid_, "user": row["user"]}
            for uuid_, row in _owned_by(sessions, owner, ignored=ignored)
        ]
        return _paginate(rows, query, state)
    if key and method == "DELETE":
        if sessions.pop(unquote(key), None) is None:
            return HTTP_NOT_FOUND, _fixture("session_delete_again_404")
        return HTTP_NO_CONTENT, None
    return HTTP_NOT_FOUND, {"detail": f"fake curl: no route for {method} {path}"}


OAUTH_PATH = re.compile(r"/api/v3/oauth2/(access_tokens|refresh_tokens)/(?:([^/]+)/)?$")
OAUTH_MODELS = {"access_tokens": "AccessToken", "refresh_tokens": "RefreshToken"}


def _oauth_route(
    method: str, match: re.Match[str], query: dict[str, list[str]], state: dict[str, Any]
) -> tuple[int, Any]:
    """`/oauth2/{access,refresh}_tokens/`: list (by `user` pk), delete."""
    users: dict[str, dict[str, Any]] = state.setdefault("users", {})
    kind, key = match.group(1), match.group(2)
    tokens: dict[str, dict[str, Any]] = state.setdefault(kind, {})
    if key is None and method == "GET":
        ignored = "oauth" in state.get("ignore_user_filters", [])
        owner: int | None = None
        if "user" in query:
            if query["user"][0] not in users:
                return HTTP_BAD_REQUEST, _fixture("oauth2_access_tokens_list_unknown_user_400")
            owner = int(query["user"][0])
        else:
            ignored = True
        template: dict[str, Any] = _fixture(f"oauth2_{kind}_list_owner")["results"][0]
        rows = [
            {
                **copy.deepcopy(template),
                "pk": int(pk),
                "user": {**template["user"], **_embedded_user(users, row["user"])},
            }
            for pk, row in _owned_by(tokens, owner, ignored=ignored)
        ]
        return _paginate(rows, query, state)
    if key is not None and method == "DELETE":
        if tokens.pop(unquote(key), None) is None:
            missing: dict[str, str] = _fixture("oauth2_access_token_delete_again_404")
            missing["detail"] = missing["detail"].replace("AccessToken", OAUTH_MODELS[kind])
            return HTTP_NOT_FOUND, missing
        return HTTP_NO_CONTENT, None
    return HTTP_NOT_FOUND, {"detail": f"fake curl: no route for {method} {match.group(0)}"}


def _core_tokens_route(
    method: str, path: str, query: dict[str, list[str]], state: dict[str, Any]
) -> tuple[int, Any]:
    """`/core/tokens/`: list (by `user__username`), delete by identifier."""
    users: dict[str, dict[str, Any]] = state.setdefault("users", {})
    tokens: dict[str, dict[str, Any]] = state.setdefault("core_tokens", {})
    key = path.rsplit("/core/tokens/", maxsplit=1)[-1].strip("/")
    if not key and method == "GET":
        owner, ignored = _username_filtered(
            query, users, ignored="core_tokens" in state.get("ignore_user_filters", [])
        )
        template: dict[str, Any] = _fixture("core_tokens_list_owner")["results"][0]
        rows = [
            {
                **copy.deepcopy(template),
                "pk": str(uuid.uuid5(uuid.NAMESPACE_URL, identifier)),
                "identifier": identifier,
                "intent": row.get("intent", "api"),
                "user": row["user"],
                "user_obj": {**template["user_obj"], **_embedded_user(users, row["user"])},
            }
            for identifier, row in _owned_by(tokens, owner, ignored=ignored)
        ]
        return _paginate(rows, query, state)
    if key and method == "DELETE":
        if tokens.pop(unquote(key), None) is None:
            return HTTP_NOT_FOUND, {"detail": "No Token matches the given query."}
        return HTTP_NO_CONTENT, None
    return HTTP_NOT_FOUND, {"detail": f"fake curl: no route for {method} {path}"}


def _users_me(state: dict[str, Any], users: dict[str, dict[str, Any]]) -> dict[str, Any]:
    """`GET /core/users/me/`: the user the shared token belongs to.

    `token_user_pk` names that user (default: the recorded akadmin); `null` drops the pk, as a
    response that does not say whose token it is.
    """
    body: dict[str, Any] = _fixture("users_me")
    if "token_user_pk" not in state:
        return body
    pk = state["token_user_pk"]
    if pk is None:
        body["user"].pop("pk", None)
        return body
    body["user"]["pk"] = pk
    owner = users.get(str(pk))
    if owner is not None:
        body["user"]["username"] = owner["username"]
    return body


def _blueprints(state: dict[str, Any]) -> list[dict[str, Any]]:
    """Blueprint instances, in the shape RECORDED from a live Authentik 2026.8.3 (LC2, issue #165):
    `pk` uuid, `name` = the blueprint's metadata name, `status`. The default holds the local-TLS
    blueprint; seed `blueprints` (a list of instances) to override, `[]` for none.
    """
    default: list[dict[str, Any]] = _fixture("blueprints_list")["results"]
    blueprints: list[dict[str, Any]] = state.get("blueprints", default)
    return blueprints


def _blueprint_listing(found: list[dict[str, Any]]) -> dict[str, Any]:
    """The recorded blueprint list envelope (`autocomplete`, `pagination`, `results`)."""
    listing: dict[str, Any] = _fixture("blueprints_list")
    listing["results"] = found
    listing["pagination"].update(
        count=len(found), total_pages=1, start_index=1 if found else 0, end_index=len(found)
    )
    return listing


def _route(state: dict[str, Any], method: str, url: str, body: dict[str, Any]) -> tuple[int, Any]:
    split = urlsplit(url)
    path = split.path
    query = parse_qs(split.query)
    users: dict[str, dict[str, Any]] = state.setdefault("users", {})
    devices: dict[str, list[dict[str, Any]]] = state.setdefault("devices", {})

    api_path = path.split("/api/v3", maxsplit=1)[-1]
    for target, status in state.get("fail_on", {}).items():
        fail_method, _, prefix = target.partition(" ")
        if method == fail_method and api_path.startswith(prefix):
            return status, {"detail": "fake failure"}
    if path.endswith("/api/v3/core/users/me/") and method == "GET":
        return HTTP_OK, _users_me(state, users)
    if path.endswith("/api/v3/core/groups/") and method == "GET":
        name = unquote(query.get("name", [""])[0])
        groups = [g for g in [_admins_group()] if not name or g["name"] == name]
        listing: dict[str, Any] = _fixture("groups_list")
        listing["results"] = groups
        return HTTP_OK, listing
    if path.endswith("/api/v3/core/users/") and method == "GET":
        username = query.get("username", [None])[0]
        return HTTP_OK, _envelope([u for u in users.values() if username in {None, u["username"]}])
    if path.endswith("/api/v3/core/users/") and method == "POST":
        errors: dict[str, list[str]] = {}
        if any(u["username"] == body.get("username") for u in users.values()):
            errors["username"] = _fixture("user_create_duplicate_400")["username"]
        if "name" not in body:
            errors["name"] = ["This field is required."]
        if errors:
            return HTTP_BAD_REQUEST, errors
        state["next_pk"] = state.get("next_pk", 1) + 1
        pk = state["next_pk"]
        users[str(pk)] = _user_document(body, pk)
        return HTTP_CREATED, users[str(pk)]
    recovery = re.search(r"/api/v3/core/users/(\d+)/recovery/$", path)
    if recovery and method == "POST":
        if recovery.group(1) not in users:
            return HTTP_NOT_FOUND, _fixture("recovery_missing_user_404")
        if not state.get("recovery_flow"):
            return HTTP_BAD_REQUEST, _fixture("recovery_no_flow_400")
        token = secrets.token_hex(16)
        # Authentik stores a recovery link as a `recovery` core token of that user.
        identifier = f"ak-recovery-{recovery.group(1)}-{secrets.token_hex(4)}"
        state.setdefault("core_tokens", {})[identifier] = {
            "user": int(recovery.group(1)),
            "intent": "recovery",
        }
        # Real Authentik builds the link from the request's own scheme, authority and web path
        # prefix (LC1b: `http://127.0.0.1:9000/...` through a port-forward; with
        # AUTHENTIK_WEB__PATH=/auth/ the path carries `/auth`).
        prefix = path.split("/api/v3/", maxsplit=1)[0]
        link = (
            f"{split.scheme}://{split.netloc}{prefix}/if/flow/ps-passkey-recovery/"
            f"?flow_token={token}"
        )
        return HTTP_OK, {"link": link}
    if path.endswith("/api/v3/authenticators/admin/webauthn/") and method == "GET":
        # Real Authentik ignores a `user` query here and lists every device.
        return HTTP_OK, _envelope(_device_documents(users, devices))
    if path.endswith("/api/v3/authenticators/admin/all/") and method == "GET":
        return _devices_all(query, users, devices, state.get("ignore_user_filters", []))
    device_match = DEVICE_PATH.search(path)
    if device_match:
        return _device_route(method, device_match, users, devices)
    if "/api/v3/core/authenticated_sessions/" in path:
        return _sessions_route(method, path, query, state)
    oauth_match = OAUTH_PATH.search(path)
    if oauth_match:
        return _oauth_route(method, oauth_match, query, state)
    if "/api/v3/core/tokens/" in path:
        return _core_tokens_route(method, path, query, state)
    if path.endswith("/api/v3/stages/invitation/invitations/") and method == "POST":
        invitation: dict[str, Any] = _fixture("invitation_created")
        invitation.update(
            pk=str(uuid.uuid4()),
            name=body.get("name", ""),
            single_use=body.get("single_use", False),
            fixed_data=body.get("fixed_data", {}),
        )
        return HTTP_CREATED, invitation
    if path.endswith("/api/v3/managed/blueprints/") and method == "GET":
        name = unquote(query.get("name", [""])[0])
        found = [b for b in _blueprints(state) if not name or b["name"] == name]
        # A fresh install: the worker has not discovered its blueprints yet, so the first N lists
        # come back empty (seed `blueprint_list_empty_calls`).
        pending = state.get("blueprint_list_empty_calls", 0)
        if pending > 0:
            state["blueprint_list_empty_calls"] = pending - 1
            found = []
        return HTTP_OK, _blueprint_listing(found)
    if path.endswith("/api/v3/crypto/certificatekeypairs/") and method == "GET":
        found_pairs = (
            [{"pk": "kp-1", "name": "ps-local-tls"}] if state.get("stale_tls_keypair") else []
        )
        return HTTP_OK, _envelope(found_pairs)
    apply_match = re.search(r"/api/v3/managed/blueprints/([^/]+)/apply/$", path)
    if apply_match and method == "POST":
        blueprint = next((b for b in _blueprints(state) if b["pk"] == apply_match.group(1)), None)
        if blueprint is None:
            return HTTP_NOT_FOUND, {"detail": "No BlueprintInstance matches the given query."}
        state.setdefault("applied_blueprints", []).append(blueprint["pk"])
        applied: dict[str, Any] = _fixture("blueprint_apply")
        applied.update(pk=blueprint["pk"], name=blueprint["name"])
        return HTTP_OK, applied
    delete = re.search(r"/api/v3/core/users/(\d+)/$", path)
    if delete and method == "DELETE":
        users.pop(delete.group(1), None)
        return HTTP_NO_CONTENT, None
    return HTTP_NOT_FOUND, {"detail": f"fake curl: no route for {method} {path}"}


def _ingress_route(state: dict[str, Any], url: str) -> tuple[int, Any, str]:
    """The ingress on port 30443: PS Service, Authentik's public paths, and a 404 for the rest.

    Returns the status, the JSON payload and the redirect target (empty when none).
    """
    split = urlsplit(url)
    path = split.path
    if path in state.get("ingress_open_paths", []):
        return HTTP_OK, {"detail": "reachable"}, ""
    if path == "/status":
        status = state.get("ingress_status_endpoint_status", HTTP_OK)
        return status, {"status": "ready", "version": "0.0.0"}, ""
    if path == "/livez":
        status = state.get("ingress_livez_status", HTTP_NOT_FOUND)
        return status, {"detail": "fake curl: no ingress route for /livez"}, ""
    if path == "/mcp/":
        return state.get("ingress_mcp_status", HTTP_UNAUTHORIZED), {"detail": "unauthorized"}, ""
    if path.endswith("/.well-known/openid-configuration"):
        requested = url.removesuffix(".well-known/openid-configuration")
        return HTTP_OK, {"issuer": state.get("ingress_issuer", requested)}, ""
    if path == "/auth/flows/-/default/authentication/":
        default = f"{split.scheme}://{split.netloc}/auth/if/flow/default-authentication-flow/"
        return HTTP_FOUND, None, state.get("ingress_redirect_location", default)
    denied = state.get("ingress_denied_status", HTTP_NOT_FOUND)
    return denied, {"detail": f"fake curl: no ingress route for {path}"}, ""


def _apply_on_request(state: dict[str, Any], method: str, url: str) -> None:
    """Add the rows of the first `on_request` trigger matching this request, then drop it."""
    triggers: dict[str, dict[str, dict[str, Any]]] = state.get("on_request", {})
    api_path = urlsplit(url).path.split("/api/v3", maxsplit=1)[-1]
    for target, additions in list(triggers.items()):
        trigger_method, _, prefix = target.partition(" ")
        if method != trigger_method or not api_path.startswith(prefix):
            continue
        for key, rows in additions.items():
            current: dict[str, Any] = state.setdefault(key, {})
            for row_key, value in rows.items():
                existing = current.get(row_key)
                if isinstance(existing, list) and isinstance(value, list):
                    existing.extend(value)
                else:
                    current[row_key] = value
        del triggers[target]
        return


def main() -> int:
    args = _parse_args(sys.argv[1:])
    state_path = Path(os.environ["PS_TEST_CURL_STATE"])
    state = _load_state(state_path)
    log_path = os.environ.get("PS_TEST_CURL_LOG")
    if log_path:
        with Path(log_path).open("a", encoding="utf-8") as log:
            log.write(json.dumps({"argv": sys.argv[1:], "url": args["url"]}) + "\n")
    url: str = args["url"]
    # An authenticated Authentik API call (token on stdin) stands for the script's own call to the
    # API; an anonymous request to the same path is what the ingress must refuse.
    authenticated_api = args["config_stdin"] and "/api/v3/" in url
    if urlsplit(url).port == INGRESS_PORT and not authenticated_api:
        status, payload, redirect = _ingress_route(state, url)
        if payload is not None:
            sys.stdout.write(json.dumps(payload))
        if args["write_out"]:
            sys.stdout.write(
                args["write_out"]
                .replace("%{http_code}", str(status))
                .replace("%{redirect_url}", redirect)
            )
        return 0
    if state.get("unreachable"):
        return EXIT_UNREACHABLE
    method = args["method"] or ("POST" if args["data"] else "GET")
    token = _bearer_token(config_stdin=args["config_stdin"])
    if token != state.get("token", "test-token"):
        status: int = state.get("token_reject_status", HTTP_FORBIDDEN)
        payload: Any = _fixture("token_invalid_403")
    else:
        body = json.loads(args["data"]) if args["data"] else {}
        status, payload = _route(state, method, args["url"], body)
        if status < HTTP_BAD_REQUEST:
            _apply_on_request(state, method, args["url"])
        _save_state(state_path, state)
    if payload is not None:
        sys.stdout.write(json.dumps(payload))
    if args["write_out"]:
        sys.stdout.write(args["write_out"].replace("%{http_code}", str(status)))
    return 0 if status < HTTP_BAD_REQUEST or "-f" not in sys.argv[1:] else 22


if __name__ == "__main__":
    sys.exit(main())
