  "nodes": [
    {
      "label": "RegulatoryInstrument",
      "properties": {
        "celex": "32016L2102",
        "effective_date": "2018-09-23",
        "id": "WEBACCESSIBILITY-1.0",
        "instrument_type": "directive",
        "jurisdiction": "EU",
        "source_type": "external",
        "status": "active",
        "title": "DIRECTIVE (EU) 2016/2102 OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL of 26 October 2016 on the accessibility of the websites and mobile applications of public sector bodies (Text with EEA relevance)",
        "version": "1.0"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.97,
        "id": "WEBACCESSIBILITY-1.0_req_art_10.4",
        "role_id": "role_commission_c5ad62",
        "text": "Before adopting a delegated act, the Commission shall consult experts designated by each Member State in accordance with the principles laid down in the Interinstitutional Agreement of 13 April 2016 on Better Law-Making.",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.93,
        "id": "WEBACCESSIBILITY-1.0_req_art_10.6",
        "role_id": "role_european_parliament_or_the_council_45638d",
        "text": "A delegated act adopted pursuant to Article 6(4) shall enter into force only if no objection has been expressed within a period of two months of notification of that act to the European Parliament and the Council, or if, before the expiry of that period, the European Parliament and the Council have both informed the Commission that they will not object.",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.98,
        "id": "WEBACCESSIBILITY-1.0_req_art_12.1a",
        "role_id": "role_member_states_ce72be",
        "text": "bring into force the laws, regulations and administrative provisions necessary to comply with this Directive by 23 September 2018",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.96,
        "id": "WEBACCESSIBILITY-1.0_req_art_12.1b",
        "role_id": "role_member_states_ce72be",
        "text": "immediately inform the Commission thereof",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.95,
        "id": "WEBACCESSIBILITY-1.0_req_art_12.1c",
        "role_id": "role_member_states_ce72be",
        "text": "when adopting those measures, ensure that they contain a reference to this Directive or are accompanied by such a reference on the occasion of their official publication",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.98,
        "id": "WEBACCESSIBILITY-1.0_req_art_12.2",
        "role_id": "role_member_states_ce72be",
        "text": "communicate to the Commission the text of the main measures of national law which they adopt in the field covered by this Directive",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.94,
        "id": "WEBACCESSIBILITY-1.0_req_art_12.3",
        "role_id": "role_member_states_ce72be",
        "text": "shall apply those measures as follows: (a) to websites of public sector bodies not published before 23 September 2018: from 23 September 2019; (b) to websites of public sector bodies not covered by point (a): from 23 September 2020; (c) to mobile applications of public sector bodies: from 23 June 2021.",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.99,
        "id": "WEBACCESSIBILITY-1.0_req_art_13.1",
        "role_id": "role_commission_c5ad62",
        "text": "carry out a review of the application of this Directive by 23 June 2022",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.98,
        "id": "WEBACCESSIBILITY-1.0_req_art_13.1#2",
        "role_id": "role_commission_c5ad62",
        "text": "take into account the Member States' reports on the outcome of the monitoring provided for in Article 8 and the use of the enforcement procedure provided for in Article 9 in that review",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.97,
        "id": "WEBACCESSIBILITY-1.0_req_art_13.1#3",
        "role_id": "role_commission_c5ad62",
        "text": "include a review of technological advances that could make accessibility easier for some types of content excluded from the scope of this Directive",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.99,
        "id": "WEBACCESSIBILITY-1.0_req_art_13.1#4",
        "role_id": "role_commission_c5ad62",
        "text": "make the findings of that review public in an accessible format",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.99,
        "id": "WEBACCESSIBILITY-1.0_req_art_4.1",
        "role_id": "role_public_sector_bodies_428bef",
        "text": "take the necessary measures to make their websites and mobile applications more accessible by making them perceivable, operable, understandable and robust",
        "type": "requirement"
      }
    },
    {
      "label": "Requirement",
      "properties": {
        "confidence": 0.95,
        "id": "WEBACCESSIBILITY-1.0_req_art_5.1",
        "role_id": "role_public_sector_bodies_428bef",
