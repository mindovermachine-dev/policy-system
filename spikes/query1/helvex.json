    {
      "label": "Requirement",
      "id": "HELVEX-SOP-1.0_req_art_sec_4.1",
      "properties": {
        "id": "HELVEX-SOP-1.0_req_art_sec_4.1",
        "text": "Service owners shall ensure access to clinical trial record systems is logged, retained, and reviewable.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "HELVEX-SOP-2.0_req_art_sec_4.1",
      "properties": {
        "id": "HELVEX-SOP-2.0_req_art_sec_4.1",
        "text": "Clinical Data Stewards shall ensure access to clinical trial record systems is logged in structured, tamper-evident form, retained for the life of the trial plus 10 years, and reviewable on demand.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "HELVEX-SOP-2.0_req_art_sec_5.1",
      "properties": {
        "id": "HELVEX-SOP-2.0_req_art_sec_5.1",
        "text": "Clinical Data Stewards shall maintain a tamper-evident audit trail of all create, modify, and delete operations on clinical trial records, per GxP Part 11 equivalence expectations.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "HELVEX-SOP-2.0_req_art_sec_5.2",
      "properties": {
        "id": "HELVEX-SOP-2.0_req_art_sec_5.2",
        "text": "QA Managers shall review the clinical trial record audit trail on a quarterly basis and document sign-off.",
        "type": "requirement",
        "status": "active"
      }
    },
