{
  "nodes": [
    {
      "label": "RegulatoryInstrument",
      "id": "ENGPRAC-3.0",
      "properties": {
        "title": "Engineering Practices Policy",
        "source_type": "internal",
        "effective_date": "2026-08-01",
        "version": "3.0",
        "status": "active"
      }
    },
    {
      "label": "Role",
      "id": "role-1",
      "properties": {
        "name": "Service Owner",
        "description": "Accountable owner of a production service and its compliance posture."
      }
    },
    {
      "label": "Role",
      "id": "role-2",
      "properties": {
        "name": "Engineering Manager",
        "description": "Owns team execution and adherence to engineering policy."
      }
    },
    {
      "label": "Role",
      "id": "role-3",
      "properties": {
        "name": "Security Engineer",
        "description": "Implements and verifies security controls across the SDLC."
      }
    },
    {
      "label": "Role",
      "id": "role-4",
      "properties": {
        "name": "SRE Lead",
        "description": "Owns reliability engineering standards and operational readiness."
      }
    },
    {
      "label": "Role",
      "id": "role-5",
      "properties": {
        "name": "QA Lead",
        "description": "Owns quality gates and release test confidence."
      }
    },
    {
      "label": "Role",
      "id": "role-6",
      "properties": {
        "name": "Data Protection Officer",
        "description": "Owns privacy engineering governance and data protection obligations."
      }
    },
    {
      "label": "Requirement",
      "id": "req-1",
      "properties": {
        "text": "Engineering managers shall maintain approved policy governance and controlled exception handling for all production services.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-2",
      "properties": {
        "text": "Service teams shall apply secure SDLC practices including threat-informed design and secure coding standards.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-3",
      "properties": {
        "text": "Engineering systems shall enforce strong authentication, least privilege, and periodic access review.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-4",
      "properties": {
        "text": "Code changes shall follow controlled release processes with rollback readiness and risk-based approvals.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-5",
      "properties": {
        "text": "Software components shall be tracked, verified, and license-compliant across the supply chain.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-6",
      "properties": {
        "text": "Releases shall satisfy quality gates with automated and risk-based test evidence before deployment.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-7",
      "properties": {
        "text": "Production services shall maintain reliability objectives, observability baselines, and recovery readiness.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-8",
      "properties": {
        "text": "Security vulnerabilities and incidents shall be triaged, remediated, and escalated within defined SLAs.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-9",
      "properties": {
        "text": "Data handling and privacy safeguards shall be implemented proportionate to data sensitivity and legal obligations.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Requirement",
      "id": "req-10",
      "properties": {
        "text": "Access and security logging shall be retained and reviewable to support traceability and audit evidence.",
        "type": "requirement",
        "status": "active"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-1",
      "properties": {
        "text": "Maintain Policy Governance and Exception Management"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-2",
      "properties": {
        "text": "Execute Secure SDLC Practices"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-3",
      "properties": {
        "text": "Enforce Engineering Identity and Access Controls"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-4",
      "properties": {
        "text": "Ensure Release and Change Safety"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-5",
      "properties": {
        "text": "Assure Software Supply Chain Integrity"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-6",
      "properties": {
        "text": "Enforce Test and Quality Gates"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-7",
      "properties": {
        "text": "Maintain Reliability and Operational Readiness"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-8",
      "properties": {
        "text": "Operate Vulnerability and Incident Response"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-9",
      "properties": {
        "text": "Implement Data Protection and Privacy Engineering"
      }
    },
    {
      "label": "Obligation",
      "id": "obl-10",
      "properties": {
        "text": "Maintain Logging and Audit Traceability"
      }
    },
